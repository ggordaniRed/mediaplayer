<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaPlayer.ViewModels"
             xmlns:m="using:MediaPlayer.Models"
             x:Class="MediaPlayer.Views.PlaylistView"
             x:DataType="vm:PlaylistViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Header / toolbar ──────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Padding="12,8"
                Background="#0f1018"
                BorderBrush="#22232f"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">

                <TextBlock Grid.Column="0"
                           Text="Playlist"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#c0c8e0"
                           VerticalAlignment="Center" />

                <ToggleButton Grid.Column="1"
                              Content="🔀"
                              IsChecked="{Binding IsShuffling}"
                              ToolTip.Tip="Shuffle"
                              Margin="4,0"
                              Classes="icon-btn" />

                <ToggleButton Grid.Column="2"
                              Content="🔁"
                              IsChecked="{Binding IsLooping}"
                              ToolTip.Tip="Loop"
                              Classes="icon-btn" />

                <Button Grid.Column="3"
                        Content="+"
                        ToolTip.Tip="Add files"
                        Margin="4,0,0,0"
                        Classes="icon-btn"
                        x:Name="AddButton" />

                <Button Grid.Column="4"
                        Content="✕"
                        Command="{Binding ClearCommand}"
                        ToolTip.Tip="Clear playlist"
                        Classes="icon-btn danger" />
            </Grid>
        </Border>

        <!-- ── Track list ──────────────────────────────────────────────────── -->
        <ListBox Grid.Row="1"
                 x:Name="TrackList"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem}"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="8,4"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="#2a2b3d"/>
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#1e1f2e"/>
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="m:MediaItem">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,2">

                        <!-- Extension badge -->
                        <Border Grid.Column="0"
                                Background="#22232f"
                                CornerRadius="3"
                                Padding="4,1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Extension}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#7c6df0" />
                        </Border>

                        <!-- Track title -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   Foreground="#c0c8e0"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <!-- Row actions -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="2">
                            <Button Content="↑"
                                    Command="{Binding $parent[ListBox].((vm:PlaylistViewModel)DataContext).MoveUpCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="micro" />
                            <Button Content="↓"
                                    Command="{Binding $parent[ListBox].((vm:PlaylistViewModel)DataContext).MoveDownCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="micro" />
                            <Button Content="✕"
                                    Command="{Binding $parent[ListBox].((vm:PlaylistViewModel)DataContext).RemoveCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="micro danger" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ── Footer ────────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Padding="12,6"
                Background="#0f1018"
                BorderBrush="#22232f"
                BorderThickness="0,1,0,0">
            <TextBlock Foreground="#505870" FontSize="11">
                <Run Text="{Binding Items.Count}" />
                <Run Text=" track(s)" />
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
