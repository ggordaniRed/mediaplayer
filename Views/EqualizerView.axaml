<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaPlayer.ViewModels"
             xmlns:m="using:MediaPlayer.Models"
             x:Class="MediaPlayer.Views.EqualizerView"
             x:DataType="vm:EqualizerViewModel">

    <Grid RowDefinitions="Auto,Auto">

        <!-- ── Toolbar: enable toggle + presets + reset + preamp ─────────── -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,0,10">

            <ToggleButton Content="EQ ON"
                          IsChecked="{Binding IsEnabled}"
                          Classes="eq-toggle" />

            <TextBlock Text="Preset:"
                       VerticalAlignment="Center"
                       Foreground="#606070"
                       FontSize="11" />

            <Button Content="Rock"      Command="{Binding LoadPresetCommand}" CommandParameter="Rock"      Classes="preset" />
            <Button Content="Pop"       Command="{Binding LoadPresetCommand}" CommandParameter="Pop"       Classes="preset" />
            <Button Content="Jazz"      Command="{Binding LoadPresetCommand}" CommandParameter="Jazz"      Classes="preset" />
            <Button Content="Classical" Command="{Binding LoadPresetCommand}" CommandParameter="Classical" Classes="preset" />
            <Button Content="Bass"      Command="{Binding LoadPresetCommand}" CommandParameter="Bass"      Classes="preset" />
            <Button Content="Treble"    Command="{Binding LoadPresetCommand}" CommandParameter="Treble"    Classes="preset" />
            <Button Content="Flat"      Command="{Binding ResetCommand}"                                   Classes="preset danger" />

            <!-- Pre-amp slider -->
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="Preamp" Foreground="#606070" VerticalAlignment="Center" FontSize="11" />
                <Slider Minimum="-20" Maximum="20"
                        Value="{Binding Preamp}"
                        Width="80"
                        Classes="volume-slider"
                        VerticalAlignment="Center" />
                <TextBlock Text="{Binding Preamp, StringFormat='{}{0:+0.0;-0.0;0} dB'}"
                           Foreground="#7c6df0"
                           Width="52" FontSize="11"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- ── 10-band vertical sliders in a bordered container ─────────── -->
        <Border Grid.Row="1"
                Background="#0f1018"
                CornerRadius="6"
                BorderBrush="#22232f"
                BorderThickness="1"
                Padding="12,10"
                IsEnabled="{Binding IsEnabled}">

            <Grid ColumnDefinitions="Auto,*">

                <!-- dB range labels on the left -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="0"
                            Width="28"
                            Margin="0,0,6,0">
                    <TextBlock Text="-20" FontSize="9" Foreground="#505870"
                               HorizontalAlignment="Right" Margin="0,0,0,0" />
                    <TextBlock Text="0" FontSize="9" Foreground="#606070" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Margin="0,30,0,30" />
                    <TextBlock Text="+20" FontSize="9" Foreground="#505870"
                               HorizontalAlignment="Right" />
                </StackPanel>

                <!-- Band sliders -->
                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding Bands}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:EqualizerBand">
                            <StackPanel Orientation="Vertical"
                                        Spacing="4"
                                        Width="56"
                                        HorizontalAlignment="Center">

                                <!-- dB value label -->
                                <TextBlock Text="{Binding Gain, StringFormat='{}{0:+0;-0;0}'}"
                                           FontSize="10"
                                           Foreground="#7c6df0"
                                           HorizontalAlignment="Center" />

                                <!-- Vertical band slider -->
                                <Slider Minimum="-20" Maximum="20"
                                        Value="{Binding Gain}"
                                        Orientation="Vertical"
                                        IsDirectionReversed="True"
                                        Height="110"
                                        Classes="eq-band"
                                        HorizontalAlignment="Center" />

                                <!-- Frequency label -->
                                <TextBlock Text="{Binding Label}"
                                           FontSize="9"
                                           Foreground="#505870"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
