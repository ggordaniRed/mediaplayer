// "The Drive Home" — adapted from BigWings' Shadertoy MdfBRX
// Converted to SkSL for SkiaSharp SKRuntimeEffect
// Simplified for SkSL limitations (no global vars, limited loops)

uniform float2 iResolution;
uniform float  iTime;
uniform float  iBass;
uniform float  iTreble;
uniform float  iEnergy;

float hash(float n) {
    return fract(sin(n * 10234.324) * 123423.235);
}

float2 hash2(float2 p) {
    float3 p3 = fract(float3(p.x, p.y, p.x) * float3(443.897, 441.423, 437.195));
    p3 += dot(p3, float3(p3.y, p3.z, p3.x) + 19.19);
    return fract(float2((p3.x + p3.y) * p3.z, (p3.x + p3.z) * p3.y));
}

float bokeh(float2 uv, float2 center, float radius, float blur) {
    float d = length(uv - center);
    float m = smoothstep(radius, radius * (1.0 - blur), d);
    m *= mix(0.7, 1.0, smoothstep(0.8 * radius, radius, d));
    return m;
}

float3 streetLights(float2 uv, float t, float side) {
    float3 col = float3(0.0);
    for (float i = 0.0; i < 1.0; i += 0.125) {
        float z = fract(i - t * 0.03 + max(side, 0.0) * 0.0625);
        float2 p = float2(side * 0.8, mix(0.6, 0.1, z));
        float distFade = (1.0 - z) * (1.0 - pow(1.0 - z, 6.0));
        float size = mix(0.005, 0.03, z);
        col += bokeh(uv, p, size, 0.1) * distFade * float3(1.0, 0.7, 0.3);
    }
    return col;
}

float3 headLights(float2 uv, float t) {
    float3 col = float3(0.0);
    for (float i = 0.0; i < 1.0; i += 0.125) {
        float z = fract(-t * 0.06 + i);
        float2 p = float2(-0.15 + hash(i * 73.0) * 0.05, mix(0.5, 0.15, z));
        float size = mix(0.003, 0.02, smoothstep(0.02, 0.07, z)) * (1.0 + iBass * 0.5);
        float distFade = max(0.01, pow(1.0 - z, 9.0));
        col += bokeh(uv, p - float2(0.02, 0.0), size, 0.15) * distFade * float3(0.8, 0.8, 1.0);
        col += bokeh(uv, p + float2(0.02, 0.0), size, 0.15) * distFade * float3(0.8, 0.8, 1.0);
    }
    return col;
}

float3 tailLights(float2 uv, float t) {
    float3 col = float3(0.0);
    for (float i = 0.0; i < 1.0; i += 0.25) {
        float ft = fract(t * 0.045 + i);
        float z = 3.0 - ft * 3.0;
        if (z < 0.2) continue;
        float2 p = float2(0.2 + hash(i * 41.0) * 0.1, mix(0.5, 0.15, ft));
        float size = 0.015 * (1.0 + iBass * 0.3);
        float distFade = ft;
        col += bokeh(uv, p - float2(0.025, 0.0), size, 0.1) * distFade * float3(1.0, 0.1, 0.1);
        col += bokeh(uv, p + float2(0.025, 0.0), size, 0.1) * distFade * float3(1.0, 0.1, 0.1);
    }
    return col;
}

float3 envLights(float2 uv, float t) {
    float3 col = float3(0.0);
    for (float i = 0.0; i < 1.0; i += 0.0625) {
        float n = hash(i + floor(t * 0.03));
        float side = sign(uv.x);
        float z = fract(i - t * 0.03 + fract(n * 234.0));
        float2 p = float2(side * (0.5 + n * 0.3), n * n * 0.3);
        p.y = mix(0.55, 0.1, z);
        float size = 0.01 * (1.0 + iEnergy * 2.0);
        float distFade = (1.0 - pow(1.0 - z, 6.0)) * 0.3;
        float3 c = mix(float3(1.0, 0.1, 0.1), float3(1.0, 0.7, 0.3), fract(n * 65.42));
        c = mix(c, float3(fract(n * 34.5), fract(n * 45.7), fract(n * 12.6)), n * 0.5);
        col += bokeh(uv, p, size, 0.15) * distFade * c;
    }
    return col;
}

float2 rainDrop(float2 uv, float seed, float t) {
    float2 ruv = uv * float2(10.0, 2.5) * 2.0;
    float2 id = floor(ruv);
    float n = hash(id.x + (id.y + seed) * 546.35);
    float2 bd = fract(ruv) - 0.5;
    bd.y *= 4.0;
    bd.x += (n - 0.5) * 0.6;
    float slide = cos(t + n * 6.28 + cos(t + n * 6.28));
    bd.y += slide * 2.0;
    float d = length(bd);
    float mainDrop = smoothstep(0.2, 0.1, d);
    return bd * mainDrop;
}

float4 main(float2 fragCoord) {
    fragCoord.y = iResolution.y - fragCoord.y;
    float2 uv = fragCoord / iResolution.xy;
    uv -= 0.5;
    uv.x *= iResolution.x / iResolution.y;

    float t = iTime;

    // Rain distortion on UV
    float2 offs = rainDrop(uv, 1.0, t) * iTreble * 3.0;
    offs += rainDrop(uv * 1.4, 10.0, t) * iTreble * 2.0;
    uv += offs * 0.02;

    // Camera bump from bass
    uv.y += sin(t * 5.0) * iBass * 0.01;

    float3 col = float3(0.0);

    col += streetLights(uv, t, 1.0);
    col += streetLights(uv, t, -1.0);
    col += headLights(uv, t);
    col += tailLights(uv, t);
    col += envLights(uv, t);

    // Sky gradient
    col += max(uv.y + 0.5, 0.0) * float3(0.05, 0.04, 0.08) * (1.0 + iEnergy);

    // Road
    float road = smoothstep(0.0, -0.02, uv.y + 0.05);
    col *= (1.0 - road * 0.7);

    // Vignette
    float vig = 1.0 - length(uv * float2(0.8, 1.2)) * 0.8;
    col *= vig;

    return float4(col, 1.0);
}
