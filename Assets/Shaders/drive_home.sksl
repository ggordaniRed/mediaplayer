// "The Drive Home" — inspired by BigWings' Shadertoy MdfBRX
// SkSL for SkiaSharp SKRuntimeEffect (GPU)
// Audio-reactive: iBass, iTreble, iEnergy drive visuals

uniform float2 iResolution;
uniform float  iTime;
uniform float  iBass;
uniform float  iTreble;
uniform float  iEnergy;

float hash(float n) {
    return fract(sin(n * 10234.324) * 123423.235);
}

float bokeh(float2 uv, float2 center, float radius, float blur) {
    float d = length(uv - center);
    float m = smoothstep(radius, radius * (1.0 - blur), d);
    m *= mix(0.6, 1.0, smoothstep(0.7 * radius, radius, d));
    return m;
}

float3 streetLights(float2 uv, float t, float side) {
    float3 col = float3(0.0);
    float energy = max(iEnergy, 0.1);
    for (float i = 0.0; i < 1.0; i += 0.1) {
        float z = fract(i - t * 0.05);
        float2 p = float2(side * (0.4 + z * 0.3), mix(0.45, -0.05, z));
        float distFade = (1.0 - z);
        distFade *= distFade;
        float size = mix(0.01, 0.06, z) * (1.0 + energy * 2.0);
        float m = bokeh(uv, p, size, 0.3);
        col += m * distFade * float3(1.0, 0.7, 0.3) * (1.5 + iBass);
    }
    return col;
}

float3 headLights(float2 uv, float t) {
    float3 col = float3(0.0);
    for (float i = 0.0; i < 1.0; i += 0.125) {
        float z = fract(-t * 0.08 + i);
        float xoff = (hash(i * 73.0) - 0.5) * 0.15;
        float2 p = float2(-0.2 + xoff, mix(0.4, -0.1, z));
        float size = mix(0.008, 0.05, z) * (1.5 + iBass);
        float distFade = pow(max(1.0 - z, 0.01), 5.0);

        col += bokeh(uv, p - float2(0.03, 0.0), size, 0.2) * distFade * float3(0.9, 0.9, 1.0) * 2.0;
        col += bokeh(uv, p + float2(0.03, 0.0), size, 0.2) * distFade * float3(0.9, 0.9, 1.0) * 2.0;

        // Reflection on wet road
        float2 rp = float2(p.x, -p.y * 0.5 - 0.15);
        col += bokeh(uv, rp, size * 1.5, 0.6) * distFade * float3(0.5, 0.5, 0.7) * 0.3;
    }
    return col;
}

float3 tailLights(float2 uv, float t) {
    float3 col = float3(0.0);
    for (float i = 0.0; i < 1.0; i += 0.2) {
        float ft = fract(t * 0.06 + i);
        float z = 1.0 - ft;
        float2 p = float2(0.15 + hash(i * 41.0) * 0.15, mix(0.35, -0.1, ft));
        float size = 0.025 * (1.0 + iBass * 0.5);

        col += bokeh(uv, p - float2(0.03, 0.0), size, 0.15) * z * float3(1.0, 0.1, 0.1) * 2.5;
        col += bokeh(uv, p + float2(0.03, 0.0), size, 0.15) * z * float3(1.0, 0.1, 0.1) * 2.5;

        // Brake light flare on bass
        if (iBass > 0.3) {
            col += bokeh(uv, p, size * 2.0, 0.5) * z * float3(1.0, 0.2, 0.1) * iBass * 2.0;
        }

        // Reflection
        float2 rp = float2(p.x, -p.y * 0.5 - 0.15);
        col += bokeh(uv, rp, size * 1.5, 0.6) * z * float3(0.8, 0.05, 0.05) * 0.4;
    }
    return col;
}

float3 envLights(float2 uv, float t) {
    float3 col = float3(0.0);
    for (float i = 0.0; i < 1.0; i += 0.05) {
        float n = hash(i + floor(t * 0.05));
        float side = (n > 0.5) ? 1.0 : -1.0;
        float z = fract(i - t * 0.04 + fract(n * 234.0));
        float2 p = float2(side * (0.3 + n * 0.4), mix(0.5, -0.05, z));
        float size = 0.015 * (1.0 + iEnergy * 3.0);
        float distFade = (1.0 - z) * 0.5;

        float3 c = float3(
            0.3 + hash(n * 34.5) * 0.7,
            0.2 + hash(n * 45.7) * 0.6,
            0.3 + hash(n * 12.6) * 0.7
        );
        col += bokeh(uv, p, size, 0.2) * distFade * c * (1.0 + iEnergy);
    }
    return col;
}

float2 rainDrop(float2 uv, float seed, float t) {
    float2 ruv = uv * float2(10.0, 2.5) * 2.0;
    float2 id = floor(ruv);
    float n = hash(id.x + (id.y + seed) * 546.35);
    float2 bd = fract(ruv) - 0.5;
    bd.y *= 4.0;
    bd.x += (n - 0.5) * 0.6;
    float slide = cos(t + n * 6.28 + cos(t + n * 6.28));
    bd.y += slide * 2.0;
    float d = length(bd);
    return bd * smoothstep(0.2, 0.1, d);
}

float4 main(float2 fragCoord) {
    fragCoord.y = iResolution.y - fragCoord.y;
    float2 uv = fragCoord / iResolution.xy;
    uv -= 0.5;
    uv.x *= iResolution.x / iResolution.y;

    float t = iTime;

    // Rain distortion — stronger with treble
    float rainStr = max(iTreble, 0.05) * 5.0;
    float2 offs = rainDrop(uv, 1.0, t) * rainStr;
    offs += rainDrop(uv * 1.4, 10.0, t) * rainStr * 0.7;
    uv += offs * 0.015;

    // Camera bump from bass
    uv.y += sin(t * 5.0) * iBass * 0.02;
    uv.x += sin(t * 3.7) * iBass * 0.008;

    float3 col = float3(0.0);

    // All light layers
    col += streetLights(uv, t, 1.0);
    col += streetLights(uv, t, -1.0);
    col += headLights(uv, t);
    col += tailLights(uv, t);
    col += envLights(uv, t);

    // Sky — subtle purple/blue gradient
    float skyGrad = max(uv.y + 0.5, 0.0);
    col += skyGrad * float3(0.08, 0.06, 0.15) * (1.0 + iEnergy * 2.0);

    // Wet road reflections — mirror the top half dimly
    if (uv.y < -0.05) {
        float roadWet = smoothstep(-0.05, -0.15, uv.y) * 0.15;
        col += col * roadWet;
    }

    // Rain streaks
    float rain = hash(fragCoord.x * 0.1 + t * 50.0) * hash(fragCoord.y * 0.3 + t * 30.0);
    rain = smoothstep(0.97, 1.0, rain) * rainStr * 0.3;
    col += float3(0.4, 0.5, 0.6) * rain;

    // Vignette
    float vig = 1.0 - length(uv * float2(0.7, 1.0)) * 0.9;
    col *= max(vig, 0.0);

    // Tone mapping — prevent blowout
    col = col / (col + 1.0);

    return float4(col, 1.0);
}
